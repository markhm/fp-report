        { "key": "reliability",     "label": "Reliability",     "color": "orange", "strong": ["reliabilit", "failover", "recover"], "weak": ["retry"] },
        { "key": "maintainability", "label": "Maintainability", "color": "purple", "strong": ["maintainab", "refactor"], "weak": ["cleanup"] }
      ]
    }
  ]
